# Terraform local directories
**/.terraform/*
.terraform/

# Terraform state files - never commit
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform variable files - may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
pip-wheel-metadata/
.pytest_cache/
.coverage

# Ansible
*.retry
.ansible/
ansible.log

# OpenShift / Kubernetes sensitive files
kubeconfig
.kube/
*.kubeconfig
*-token*
*token*
*.pem
*.key
*.crt

# Cloud credentials
.aws/
.azure/
credentials
config

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
