pipeline {
    agent any

    environment {
        SONARQUBE_SERVER = 'SonarQube'
        DOCKER_HUB_USER  = 'jayaram232' // Replace with your Docker Hub username
        IMAGE_NAME       = "${DOCKER_HUB_USER}/flask-lab:${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('python') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Unit Tests (JUnit Report)') {
            steps {
                dir('python') {
                    sh '''
                        . venv/bin/activate
                        pytest --junitxml=reports/junit-report.xml --cov=app --cov-report=xml:coverage.xml test_app.py
                    '''
                }
            }
            post {
                always {
                    junit 'python/reports/junit-report.xml'
                }
            }
        }

        stage('SonarQube Quality Scan') {
            steps {
                dir('python') {
                    // Scan within python directory using properties file
                    sh '/usr/local/bin/sonar-scanner || /opt/sonar-scanner/bin/sonar-scanner || echo "SonarQube scan skipped"'
                }
            }
        }

        stage('Build & Push Docker Artifact') {
            steps {
                dir('python') {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                            sh """
                                echo \$DH_PASS | docker login -u \$DH_USER --password-stdin
                                docker build -t ${IMAGE_NAME} .
                                docker tag ${IMAGE_NAME} ${DOCKER_HUB_USER}/flask-lab:latest
                                docker push ${IMAGE_NAME}
                                docker push ${DOCKER_HUB_USER}/flask-lab:latest
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            dir('python') {
                sh 'rm -rf venv __pycache__ .pytest_cache reports coverage.xml'
            }
        }
        success {
            echo 'Flask CI Pipeline completed successfully!'
        }
        failure {
            echo 'CI Pipeline failed. Check console output.'
        }
    }
}
